---
import Base from '../layouts/Base.astro';
import Sources from '../components/Sources.astro';
import raw from '../data/his-own-account.json';
import { longDate, shortDate, monthYear, shortMonthYear, weekday, slug, sourceCount, smartAll, money } from '../lib/fmt.js';

// The data keeps straight quotes; the page renders typographer's quotes.
const dive = smartAll(raw);
const { meta, hero, ledger, days, claims, voices, rules, watch, take, corrections } = dive;

const ACTORS = {
  wh:       { label: 'The president, his family and his administration', color: 'var(--ac-wh)' },
  payer:    { label: 'Buyers and payers',  color: 'var(--ac-payer)' },
  court:    { label: 'The courts',         color: 'var(--ac-court)' },
  press:    { label: 'Press and watchdogs', color: 'var(--ac-press)' },
  congress: { label: 'Congress',           color: 'var(--ac-congress)' },
};

// Every number on the page is computed from the data file. Only rows marked `form` (exact
// figures from his disclosure) are ever added together.
const formRows = ledger.filter((r) => r.form);
const sumOf = (rows) => rows.reduce((n, r) => n + (r.amount || 0), 0);
const total = sumOf(formRows);
const byGroup = (g) => ledger.filter((r) => r.group === g);
const crypto = sumOf(byGroup('crypto'));
const licensing = sumOf(byGroup('licensing'));
const largest = formRows.reduce((a, r) => (r.amount > a.amount ? r : a), formRows[0]);
const settlements = byGroup('settlements');
const paidElsewhere = sumOf(settlements.filter((r) => r.recipient));
const events = days.flatMap((d) => d.events.map((e) => ({ ...e, date: d.date, month: d.month })));
const eventCount = events.length;
const sources = sourceCount(dive);
const seedCount = dive.trackerIds.length;
const paraphrased = (c) => /paraphrased/i.test(c.who);
const whoLabel = (c) => c.who.replace(/,\s*paraphrased/i, '');
const pct = (a, b) => Math.round((a / b) * 100);

// The record spans two years, so it is grouped by month.
const months = [];
for (const e of events) {
  const key = e.date.slice(0, 7);
  let m = months.find((x) => x.key === key);
  if (!m) months.push((m = { key, first: e.date, events: [] }));
  m.events.push(e);
}

// The ledger is read in groups. The first four are his reported income and add up to the
// total; the last is context and is never added.
const GROUPS = [
  { key: 'crypto', label: 'Crypto ventures that carry his name' },
  { key: 'licensing', label: 'Licensing his name abroad' },
  { key: 'settlements', label: 'Settlements from companies', note: `${money(paidElsewhere, true)} of it is marked as paid to his library foundation or to the ballroom fund.` },
  { key: 'business', label: 'Businesses he already owned', note: 'Gross revenue, not profit.' },
  { key: 'around', label: 'Around his family\u2019s ventures', note: 'Not his reported income, and not added to any total on this page.' },
].map((g) => {
  const rows = byGroup(g.key);
  return { ...g, rows, sum: g.key === 'around' ? null : sumOf(rows) };
});

const stats = [
  { n: money(total, true), label: 'Came in during 2025, by the exact dollar figures on his disclosure' },
  { n: money(crypto, true), label: `From crypto ventures that carry his name, ${pct(crypto, total)}% of the total` },
  { n: money(largest.amount, true), label: 'The largest single line: royalties from a meme coin launched three days before the inauguration' },
  { n: money(licensing, true), label: 'From licensing his name to foreign developers, including in the UAE, Saudi Arabia and Qatar' },
];

const NAV = [
  { href: '#ledger', label: 'The Ledger' },
  { href: '#record', label: 'The Record' },
  { href: '#claims', label: 'Claims' },
  { href: '#voices', label: 'Who Spoke' },
  { href: '#rules', label: 'The Rules' },
  { href: '#take', label: 'Our Take' },
  { href: '#watch', label: 'Watch' },
  { href: '#method', label: 'Method' },
];

const description = `${meta.dek} ${eventCount} documented events, ${claims.length} explanations set against the record, and ${sources} sources.`;
---

<Base title={`${meta.title}: What the President Reported Coming In | Deep Dives`} ogTitle={`${meta.title}: What the President Reported Coming In`} description={description} nav={NAV}>

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <div class="hero">
    <div class="wrap">
      <p class="eyebrow"><a href="/corruption">Corruption</a> · {meta.kicker} · Updated {longDate(dive.updated)} · {sources} sources</p>
      <h1>By his own <span class="accent">account</span>.</h1>

      <!-- The one question this page answers, answered in a sentence, with the rule that
           makes it matter. Everything below is the evidence. -->
      <div class="question-card">
        <p class="qc-lbl">The question</p>
        <p class="qc-q">{hero.question}</p>
        <p class="qc-lbl">What the record shows</p>
        <p class="qc-a">{hero.answer}</p>
        <p class="qc-rule">{hero.rule}</p>
        <Sources sources={hero.ruleSources} />
      </div>

      <a class="status-strip" href="#stand">
        <span class="ss-lbl">Where it stands</span>
        <span class="ss-status">{meta.status}</span>
        <span class="ss-more">As of {shortDate(dive.updated)} ↓</span>
      </a>

      <div class="hero-body">
        <div>{hero.deck.map((p) => <p class="deck">{p}</p>)}</div>
        <blockquote class="hero-quote">
          <p class="lead">{hero.quote.lead}</p>
          <p>“{hero.quote.text}”</p>
          <cite>{hero.quote.cite}</cite>
          <Sources sources={hero.quote.sources} />
        </blockquote>
      </div>

      <div class="statrow is-dive" style={`--n:${stats.length}`}>
        {stats.map((s) => <div class="stat"><div class="num">{s.n}</div><div class="lbl">{s.label}</div></div>)}
      </div>
    </div>
  </div>

  <!-- ── HOW TO READ ──────────────────────────────────────────────────── -->
  <section id="readme" aria-label="How to read this page">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">How to read this page</p>
        <h2>Facts and takes are separated. On purpose.</h2>
      </div>
      <div class="readme-grid">
        <div class="readme-card facts">
          <h3>The facts</h3>
          <p>
            Everything outside the labeled take is reporting: contracts, dates, names, direct quotations
            and court rulings, each linked to where it came from. {sources} sources in all, including
            right-leaning outlets where they covered the story. Every quotation on this page has been
            checked word for word against its source.
          </p>
        </div>
        <div class="readme-card take">
          <h3>Our take</h3>
          <p>
            When we give an opinion it is labeled, set apart, and easy to skip. Ours is near the end
            of the page. You do not have to share it to use everything else here: the record is laid
            out so you can check it and decide for yourself.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHERE IT STANDS ──────────────────────────────────────────────── -->
  <section id="stand" aria-label="Where it stands">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">As of {longDate(dive.updated)}</p>
        <h2>Where it stands</h2>
      </div>
      <div class="stand">
        <div class="stand-now">
          <p class="stand-lbl">Status</p>
          <p class="stand-status">{meta.status}</p>
          <p>{meta.statusText}</p>
        </div>
        <ul class="stand-dates">
          {watch.map((w) => (
            <li><span class="d">{w.date ? shortDate(w.date) : w.when}</span><span><strong>{w.title}.</strong></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── THE LEDGER ───────────────────────────────────────────────────── -->
  <section id="ledger" aria-label="The ledger">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">What came in, and from whom</p>
        <h2>The ledger</h2>
        <p class="sub">
          {meta.formNote} Each row gives the line of the filing it comes from, so you can check it. The
          first four groups add up to {money(total)}. The last group is money around his family’s ventures
          that is not his reported income; it is shown for context and never added in.
        </p>
      </div>
      <div class="ledger" role="table" aria-label="What came in during 2025, by source">
        <div class="lg-row lg-head" role="row">
          <span role="columnheader">When</span>
          <span role="columnheader">What</span>
          <span role="columnheader">Paid by</span>
          <span role="columnheader" class="lg-amt">Amount</span>
        </div>
        {GROUPS.map((g) => [
          <div class="lg-row lg-group" role="row">
            <span role="cell" class="lg-group-name">{g.label}{g.note && <span class="lg-group-note">{g.note}</span>}</span>
            <span role="cell" class="lg-amt">{g.sum !== null && money(g.sum)}</span>
          </div>,
          ...g.rows.map((r) => (
          <div class={`lg-row ${r.form ? 'is-form' : 'is-around'}`} role="row">
            <span class="lg-when" role="cell">{r.when}</span>
            <span class="lg-item" role="cell">
              <strong>{r.item}</strong>
              <span class="lg-note">{r.note}</span>
              {r.line && <span class="lg-line">Disclosure {r.line}</span>}
              <Sources sources={r.sources} />
            </span>
            <span class="lg-payer" role="cell"><span class="cell-lbl">Paid by</span>{r.payer}{r.recipient && <span class="lg-recip">Paid to: {r.recipient}</span>}</span>
            <span class="lg-amt" role="cell">{r.approx ? '~' : ''}{money(r.amount, r.amount >= 1e8)}</span>
          </div>
          )),
        ])}
      </div>
    </div>
  </section>

  <!-- ── THE RECORD ───────────────────────────────────────────────────── -->
  <section id="record" aria-label="The record, in order">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">In order</p>
        <h2>The record</h2>
        <p class="sub">
          {eventCount} documented events over {months.length} months, from the launch of his family’s crypto company to the Senate vote on the bill that would regulate it.
          Each links to its sources; each has its own address, so you can send someone a single moment.
        </p>
      </div>
      <div class="actor-legend" aria-hidden="true">
        {Object.values(ACTORS).map((a) => <span><i style={`background:${a.color}`}></i>{a.label}</span>)}
      </div>

      <!-- The year at a glance: one cell per month, a dot per event in the actor's
           color, and the month's first headline. Each cell jumps to its month. -->
      <nav class="daystrip is-months" aria-label="Jump to a month">
        {months.map((m) => (
          <a class="ds-cell" href={`#m-${m.key}`}>
            <span class="ds-date">{shortMonthYear(m.first)}</span>
            <span class="ds-count">
              <span class="ds-dots" aria-hidden="true">{m.events.map((e) => <i style={`background:${ACTORS[e.actor].color}`}></i>)}</span>
              <span class="ds-cnt">{m.events.length} {m.events.length === 1 ? 'event' : 'events'}</span>
            </span>
            <span class="ds-lead">{m.events[0].title}</span>
          </a>
        ))}
      </nav>

      <div class="days">
        {months.map((m) => (
          <div class="day" id={`m-${m.key}`}>
            <h3 class="day-head"><span class="dow">{monthYear(m.first)}</span> <span class="cnt">{m.events.length} {m.events.length === 1 ? 'event' : 'events'}</span></h3>
            <ol class="events">
              {m.events.map((e) => (
                <li class="ev" data-actor={e.actor} id={`${e.date}-${slug(e.title)}`}>
                  <div class="ev-meta">
                    <span class="ev-date">{e.month ? monthYear(e.date) : `${weekday(e.date).slice(0, 3)} ${shortDate(e.date)}`}</span>
                    {e.time && <span class="ev-time">{e.time}</span>}
                    <span class="actor-chip">{ACTORS[e.actor].label}</span>
                  </div>
                  <h3>{e.title}</h3>
                  <div class="ev-body">{e.body.map((p) => <p>{p}</p>)}</div>
                  <Sources sources={e.sources} />
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── THE CLAIM AND THE RECORD ─────────────────────────────────────── -->
  <section id="claims" aria-label="The explanation and the record">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Checked against the record</p>
        <h2>The explanation and the record</h2>
        <p class="sub">
          What the president, the White House, his family business and its partners say, in their own words,
          next to what the documents and the reporting show.
        </p>
      </div>

      <div class="ev-table is-compare" role="table" aria-label="The explanations and the record">
        <div class="ev-row ev-head" role="row">
          <span role="columnheader">What was said</span>
          <span role="columnheader">What the record shows</span>
        </div>
        {claims.map((c) => (
          <div class="ev-row" role="row">
            <span class="ev-claim" role="cell">
              <span class="cell-lbl">What was said</span>
              {paraphrased(c)
                ? <strong class="unquoted">{c.claim}</strong>
                : <strong>“{c.claim}”</strong>}
              <span class="ev-when">{whoLabel(c)}</span>
              {paraphrased(c) && <span class="para-note">{c.note || 'Paraphrased'}</span>}
            </span>
            <span class="ev-found" role="cell">
              <span class="cell-lbl">What the record shows</span>
              <strong>{c.found}</strong>
              <span class="ev-detail">{c.detail}</span>
              <Sources sources={c.sources} />
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHO SPOKE ────────────────────────────────────────────────────── -->
  <section id="voices" aria-label="Who objected and who defended it">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Both sides, in their own words</p>
        <h2>Who objected, and who defended it</h2>
        <p class="sub">
          The strongest version of each side, quoted. Two of the objectors are Republicans: a senator who has
          long championed digital assets and the congressman who was leading negotiations on the stablecoin bill.
        </p>
      </div>
      <div class="voices">
        <div class="voice-col is-objected">
          <h3>Objected</h3>
          {voices.objected.map((v) => (
            <div class="voice">
              <blockquote>“{v.quote}”</blockquote>
              <p class="who">{v.who}<span class="role">{v.role}</span></p>
              <Sources sources={v.sources} />
            </div>
          ))}
        </div>
        <div class="voice-col is-defended">
          <h3>Defended</h3>
          {voices.defended.map((v) => (
            <div class="voice">
              <blockquote>“{v.quote}”</blockquote>
              <p class="who">{v.who}<span class="role">{v.role}</span></p>
              <Sources sources={v.sources} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE RULES ────────────────────────────────────────────────────── -->
  <section id="rules" aria-label="The rules that apply">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">What governs a president’s money</p>
        <h2>The rules</h2>
        <p class="sub">
          What a president must disclose, and what he may keep. Most of the rules that bind his appointees do
          not bind him.
        </p>
      </div>
      <ol class="precedent is-rules">
        {rules.map((r) => (
          <li>
            <span class="yr">{r.label}</span>
            <div>
              <p class="case">{r.name}</p>
              <p class="holding">{r.body}</p>
              <Sources sources={r.sources} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── OUR TAKE ─────────────────────────────────────────────────────── -->
  <section id="take" aria-label="Our take">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Reading the record</p>
        <h2>Our take</h2>
      </div>
      <div class="ev-take">
        <p class="take-lbl">Our take — opinion, not reporting</p>
        {take.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ── WHAT TO WATCH ────────────────────────────────────────────────── -->
  <section id="watch" aria-label="What to watch">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Dated triggers</p>
        <h2>What to watch</h2>
        <p class="sub">The record above is history. These are the dates and open questions where the story continues.</p>
      </div>
      <ul class="watch-list">
        {watch.map((w) => (
          <li>
            <span class="watch-when">{w.when}</span>
            <span class="watch-what"><strong>{w.title}.</strong> {w.text}{w.sources && <Sources sources={w.sources} />}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── METHOD ───────────────────────────────────────────────────────── -->
  <section id="method" aria-label="Method">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">Standards</p>
        <h2>Method</h2>
      </div>
      <div class="method-grid">
        <div class="method-card">
          <h3>Where this comes from</h3>
          <ul>
            <li>This page is built from {seedCount} Trump Tracker entries, each through the tracker’s validation protocol: two independent sources for any core claim, primary documents preferred, single-sourced claims labeled.</li>
            <li>This page answers one question: is he profiting from the office? Its companion pages take the other two questions in the <a href="/corruption">corruption section</a>: whether access is being sold, in <a href="/the-ballroom">The Ballroom</a>, and whether public money is promoting him, in <a href="/paid-for">Paid For</a>. The research site’s <a href="https://research.thetrumptracker.com/corruption/" target="_blank" rel="noopener noreferrer">corruption section</a> covers the wider record.</li>
            <li>Right-leaning outlets are cited where they covered the story, including Fox News, Fox Business and the Daily Caller.</li>
          </ul>
        </div>
        <div class="method-card">
          <h3>How it is checked</h3>
          <ul>
            <li>An automated check runs on every change: every link on this page must appear in a seed entry’s sources, and every quotation must appear word for word in a seed entry. Either failure blocks the page.</li>
            <li>Before publishing, each quotation and figure was also checked against the saved text of the specific source attached to it, and the ledger against the 927-page filing itself. That check found errors in eleven of the underlying tracker entries, which were corrected there first and are summarized under Corrections.</li>
            <li>The ledger’s amounts are the exact dollar figures in the filing’s income column, grouped and added by us; each row names its lines. Amounts the filing states only as ranges, including every stock trade, are not counted.</li>
            <li>Where an account rests on anonymous sources, the page says so where it appears.</li>
          </ul>
        </div>
        <div class="method-card">
          <h3>What we mean by the record</h3>
          <ul>
            <li>It means what the documents say: contracts, releases, rulings, sworn testimony and the text of what was published. It does not mean our reading of them.</li>
            <li>The filing reports gross revenue for his businesses, so the total is money coming in, not profit. Settlement money is counted where the filing lists it, and the ledger shows where the filing says it was paid.</li><li>Timing is not proof. Where money arrived near a government decision, the page says what happened in what order and what, if anything, links them.</li>
          </ul>
        </div>
        <div class="method-card">
          <h3>Corrections</h3>
          <ul>
            <li>Corrections are made openly. This log covers the page and the tracker entries it draws on.</li>
          </ul>
          {corrections.length
            ? <ul class="corrections">{corrections.map((c) => <li><span class="d">{longDate(c.date)}</span>{c.text}</li>)}</ul>
            : <p class="corr-none">None so far.</p>}
        </div>
      </div>
    </div>
  </section>

  <script>
    // ── scroll-spy on the section nav (the topbar's, and the phone rail's) ──
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.topnav a, .subnav a')];
    const rail = document.querySelector<HTMLElement>('.subnav-inner');
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('is-active', l.getAttribute('href') === '#' + e.target.id));
        const on = rail?.querySelector<HTMLElement>(`a[href="#${e.target.id}"]`);
        if (rail && on && rail.offsetParent) rail.scrollTo({ left: on.offsetLeft - 16, behavior: reduce ? 'auto' : 'smooth' });
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    ['ledger', 'record', 'claims', 'voices', 'rules', 'take', 'watch', 'method'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) spy.observe(el);
    });
  </script>
</Base>
